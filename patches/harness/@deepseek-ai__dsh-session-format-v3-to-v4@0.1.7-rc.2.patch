+/**
+ * Call id of one tool result row: the canonical V4 message carries it as a
+ * field, while a released V3 wrapper keeps it on the tool source.
+ * @param message - message payload of a tool/result row.
+ * @returns the call id when the row names one.
+ */
+function resultCallId(message: SessionFormatJsonValue | undefined): string | undefined {
+  if (!isSessionFormatJsonObject(message)) return undefined
+  const direct = message['toolCallId']
+  if (typeof direct === 'string' && direct.length > 0) return direct
+  const source = message['source']
+  const viaSource = isSessionFormatJsonObject(source) ? source['callId'] : undefined
+  return typeof viaSource === 'string' && viaSource.length > 0 ? viaSource : undefined
