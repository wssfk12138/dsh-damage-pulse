{
  "name": "dsh-damage-pulse",
  "version": "4.0.4",
  "description": "DeepSeek Harness balance monitor with a whale-girl companion and cache-aware damage animations for every token charge.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "assets/**/*",
    "docs/assets/dsh-damage-pulse-peak-valley-whale-poster.png",
    "docs/assets/fastaitoken-channel-models.png",
    "docs/assets/readme/dsh-damage-pulse-wechat-live.jpg",
    "docs/assets/readme/whale-girl-critical-damage.png",
    "docs/assets/readme/whale-girl-idle-bite-finger.png",
    "lib/index.js",
    "lib/client.js",
    "lib/client.js.map",
    "cordis.patch.yml",
    "tsconfig.bundle.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test tests/*.test.ts && vitest run packages/util/token-monitor-contract/tests packages/client/ui-token-monitor/tests plugins/dsh-token-monitor/tests plugins/wechat-notify/tests",
    "typecheck": "tsc --noEmit -p tsconfig.bundle.json",
    "build": "tsdown",
    "check:bundle": "node scripts/check-standard-bundle.mjs",
    "pack:check": "pnpm pack --dry-run"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
     "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-model-selection"
      ],
      "platform": "web"
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wssfk12138/dsh-damage-pulse.git"
  },
  "bugs": {
    "url": "https://github.com/wssfk12138/dsh-damage-pulse/issues"
  },
  "homepage": "https://github.com/wssfk12138/dsh-damage-pulse#readme",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "token-monitor",
    "balance-monitor",
    "damage-animation",
    "cache-aware"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-connection": "^0.1.0-rc.5 || ^0.1.1-rc.2 || ^0.1.2-alpha.1 || ^0.1.3-alpha.1",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.0-rc.5 || ^0.1.1-rc.2 || ^0.1.2-alpha.1 || ^0.1.3-alpha.1",
    "@deepseek-ai/dsh-client-ui-layout": "^0.1.0-rc.5 || ^0.1.1-rc.2 || ^0.1.2-alpha.1 || ^0.1.3-alpha.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.5 || ^0.1.1-rc.2 || ^0.1.2-alpha.1 || ^0.1.3-alpha.1",
    "@deepseek-ai/dsh-credentials": "^0.1.0-rc.5 || ^0.1.1-rc.2 || ^0.1.2-alpha.1 || ^0.1.3-alpha.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.5 || ^0.1.1-rc.2 || ^0.1.2-alpha.1 || ^0.1.3-alpha.1",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.5 || ^0.1.1-rc.2 || ^0.1.2-alpha.1 || ^0.1.3-alpha.1",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.5 || ^0.1.1-rc.2 || ^0.1.2-alpha.1 || ^0.1.3-alpha.1",
    "@deepseek-ai/dsh-session-persistence": "^0.1.0-rc.5 || ^0.1.1-rc.2 || ^0.1.2-alpha.1 || ^0.1.3-alpha.1",
    "@deepseek-ai/dsh-session-projection": "^0.1.0-rc.5 || ^0.1.1-rc.2 || ^0.1.2-alpha.1 || ^0.1.3-alpha.1",
    "@deepseek-ai/dsh-session-projection-cache": "^0.1.0-rc.5 || ^0.1.1-rc.2 || ^0.1.2-alpha.1 || ^0.1.3-alpha.1",
