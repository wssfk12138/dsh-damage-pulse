{
  "name": "dsh-damage-pulse",
  "version": "4.1.3",
  "description": "DeepSeek Harness balance monitor with a whale-girl companion and cache-aware damage animations for every token charge.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "assets/**/*",
    "docs/assets/dsh-damage-pulse-peak-valley-whale-poster.png",
    "docs/assets/fastaitoken-channel-models.png",
    "docs/assets/readme/dsh-damage-pulse-wechat-live.jpg",
    "docs/assets/readme/usage-details.png",
    "docs/assets/readme/usage-details-columns.png",
    "docs/assets/readme/usage-details-by-provider.png",
    "docs/assets/readme/fee-explanation.png",
    "docs/assets/readme/billing-rules.png",
    "docs/assets/readme/balance-script.png",
    "docs/assets/readme/notification-settings.png",
    "docs/assets/readme/wechat-sponsor-qr.png",
    "docs/assets/readme/module-management.png",
    "docs/assets/readme/balance-card-usage.png",
    "docs/assets/readme/balance-card-no-credentials.png",
    "docs/assets/readme/balance-card-context-menu.png",
    "docs/assets/readme/whale-girl-critical-damage.png",
    "docs/assets/readme/whale-girl-idle-bite-finger.png",
    "patches/**/*",
    "lib/index.js",
    "lib/client.js",
    "lib/client.js.map",
    "runtime/**/*",
    "cordis.patch.yml",
    "tsconfig.bundle.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test tests/*.test.ts && vitest run packages/util/token-monitor-contract/tests packages/client/ui-token-monitor/tests plugins/dsh-token-monitor/tests plugins/wechat-notify/tests",
    "typecheck": "tsc --noEmit -p tsconfig.bundle.json",
    "build": "tsdown",
    "check:bundle": "node scripts/check-standard-bundle.mjs",
    "pack:check": "pnpm pack --dry-run",
    "prepack": "node scripts/prepare-package-runtime.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-model-selection"
      ],
      "platform": "web"
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wssfk12138/dsh-damage-pulse.git"
  },
  "bugs": {
    "url": "https://github.com/wssfk12138/dsh-damage-pulse/issues"
  },
  "homepage": "https://github.com/wssfk12138/dsh-damage-pulse#readme",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "token-monitor",
    "balance-monitor",
    "damage-animation",
    "cache-aware"
  ],
  "license": "MIT",
